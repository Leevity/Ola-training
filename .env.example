LEARNER_ORIGIN=https://learn.example.com
MOBILE_ORIGIN=https://mobile.example.com
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
OPENMAIC_URL=
OLA_BRIDGE_SECRET=
# Required before saving model credentials in production; stable 64-character hex value.
AI_CONFIG_ENCRYPTION_KEY=
