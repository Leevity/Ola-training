# Local: PGlite persists PostgreSQL data under DATA_DIR. Production: external PostgreSQL required.
NODE_ENV=development
HOST=127.0.0.1
PORT=4190
ADMIN_ORIGIN=http://127.0.0.1:4180
LEARNER_ORIGIN=http://127.0.0.1:4181
MOBILE_ORIGIN=http://127.0.0.1:4173
# Optional additional exact origins, comma separated (e.g. Tailscale frontend addresses).
EXTRA_ALLOWED_ORIGINS=
DATA_DIR=./data
DATABASE_URL=
# First boot only. If absent in development, a random password is written to data/bootstrap-credentials.txt.
BOOTSTRAP_ADMIN_EMAIL=admin@ola.local
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=12
# Optional, private OpenMAIC API. Configure the matching OLA_BRIDGE_SECRET in OpenMAIC.
OPENMAIC_URL=
OLA_BRIDGE_SECRET=
# AI provider keys are AES-256-GCM encrypted per tenant. Production: supply a stable 64-character hex key.
# Development: if absent, a local key is created at DATA_DIR/ai-encryption-key. Back it up together with the database.
AI_CONFIG_ENCRYPTION_KEY=
# Model request deadline, including response body; default 90 seconds, range 1–180 seconds.
AI_REQUEST_TIMEOUT_MS=90000
